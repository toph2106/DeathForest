  m_EditorClassIdentifier: Assembly-CSharp::BedSleepCutscene
  sitCameraPoint: {fileID: 1504594143}
  pillowCameraPoint: {fileID: 320732867}
  approachDuration: 2
  lowerToSitDuration: 1
