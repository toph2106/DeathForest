  descendToPillowDuration: 1.5
  tiltToFullCeilingDuration: 1
  holdOnBackDuration: 1.5
  turnHeadLeftDuration: 1.5
  holdEyesOpenDuration: 3
  englishPrompt: '[F] Go to Sleep'
  vietnamesePrompt: "[F] N\u1EB1m xu\u1ED1ng ng\u1EE7"
  fadeToBlackAfterSleep: 1
  fadeScreenImage: {fileID: 1981951292}
  fadeOutDuration: 4
  subtitleTextUI: {fileID: 1324252486}
  useTypewriterEffect: 1
  typewriterSpeed: 0.03
  sleepDialogues:
  - vietnameseDialogue: "M\u1EC7t m\u1ECFi qu\xE1... Cu\u1ED1i c\xF9ng c\u0169ng
      \u0111\u01B0\u1EE3c ch\u1EE3p m\u1EAFt."
    englishDialogue: So tired... Finally I can get some sleep.
  - vietnameseDialogue: "\u01AFm... Ai g\xF5 c\u1EEDa gi\u1EDD n\xE0y th\u1EBF...?"
    englishDialogue: Ugh... Who is knocking at this hour...?
  - vietnameseDialogue: "Chuy\u1EC7n g\xEC \u0111ang x\u1EA3y ra v\u1EADy...?"
    englishDialogue: What's going on...?
  requireComputerBeforeSleep: 1
  requireLightOffBeforeSleep: 1
  lockedNeedComputerDialogues:
  - vietnameseDialogue: "V\u1EABn ch\u01B0a bu\u1ED3n ng\u1EE7 l\u1EAFm... qua xem
      m\xE1y t\xEDnh ch\xFAt \u0111\xE3."
    englishDialogue: Not sleepy yet... I should check my computer first.
    holdDuration: 2.5
  lockedNeedTurnOffLightDialogues:
  - vietnameseDialogue: "Ch\xF3i m\u1EAFt qu\xE1, ph\u1EA3i t\u1EAFt \u0111\xE8n
      tr\u01B0\u1EDBc khi ng\u1EE7..."
    englishDialogue: Too bright, I need to turn off the light before going to sleep...
    holdDuration: 2.5
